    {
      "id": "semantic-03",
      "category": "semantic_only",
      "mode": "structured",
      "turns": [
        {
          "query": "films about dreams and altered reality",
          "expected_filter": {},
          "expected_slots": {},
          "expected_docs": ["Paprika", "Inception", "Perfect Blue", "Memento"],
          "expected_answer_contains": ["dream"]
        }
      ]
    },

    {
      "id": "followup-01",
      "category": "followup",
      "mode": "structured",
      "description": "Add a constraint, then a second, without losing the first.",
      "turns": [
        {
          "query": "show me anime movies",
          "expected_filter": {"genre": {"$in": ["anime"]}},
          "expected_slots": {"genre": {"operator": "in", "value": ["anime"]}},
          "expected_docs": ["Paprika", "Perfect Blue", "Akira", "My Neighbor Totoro", "Spirited Away", "Grave of the Fireflies"]
        },
        {
          "query": "only ones released before 1990",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"release_date": {"$lt": "1990-01-01"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "release_date": {"operator": "lt", "value": "1990-01-01"}
          },
          "expected_docs": ["Akira", "My Neighbor Totoro", "Grave of the Fireflies"],
          "expected_answer_contains": ["1988"]
        },
        {
          "query": "and rated above 8.2",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"release_date": {"$lt": "1990-01-01"}}, {"rating": {"$gt": 8.2}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "release_date": {"operator": "lt", "value": "1990-01-01"},
            "rating": {"operator": "gt", "value": 8.2}
          },
          "expected_docs": ["Akira", "Grave of the Fireflies"]
        }
      ]
    },
    {
      "id": "followup-02",
      "category": "correction",
      "mode": "structured",
      "description": "Direction correction on a date bound; the genre slot must survive.",
      "turns": [
        {
          "query": "show me anime movies",
          "expected_filter": {"genre": {"$in": ["anime"]}},
          "expected_slots": {"genre": {"operator": "in", "value": ["anime"]}},
          "expected_docs": ["Paprika", "Perfect Blue", "Akira", "My Neighbor Totoro", "Spirited Away", "Grave of the Fireflies"]
        },
        {
          "query": "released before 1990",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"release_date": {"$lt": "1990-01-01"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "release_date": {"operator": "lt", "value": "1990-01-01"}
          },
          "expected_docs": ["Akira", "My Neighbor Totoro", "Grave of the Fireflies"]
        },
        {
          "query": "no, I meant after 1990, not before",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"release_date": {"$gt": "1990-01-01"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "release_date": {"operator": "gt", "value": "1990-01-01"}
          },
          "expect_correction_on": ["release_date"],
          "expected_docs": ["Paprika", "Perfect Blue", "Spirited Away"],
          "expected_answer_contains": ["199", "200"]
        }
      ]
    },
    {
      "id": "followup-03",
      "category": "correction",
      "mode": "structured",
      "description": "Genre correction mid-thread; the director slot must survive.",
      "turns": [
        {
          "query": "thriller movies by Christopher Nolan",
          "expected_filter": {"$and": [{"genre": {"$in": ["thriller"]}}, {"director": {"$eq": "Christopher Nolan"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["thriller"]},
            "director": {"operator": "eq", "value": "Christopher Nolan"}
          },
          "expected_docs": ["Inception", "The Prestige", "Memento"]
        },
        {
          "query": "actually make it scifi instead",
          "expected_filter": {"$and": [{"genre": {"$in": ["scifi"]}}, {"director": {"$eq": "Christopher Nolan"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["scifi"]},
            "director": {"operator": "eq", "value": "Christopher Nolan"}
          },
          "expect_correction_on": ["genre"],
          "expected_docs": ["Inception", "Interstellar"],
          "expected_answer_contains": ["Nolan"]
        }
      ]
    },
    {
      "id": "followup-04",
      "category": "correction",
      "mode": "structured",
      "description": "Clearing one slot must leave the others intact.",
      "turns": [
        {
          "query": "anime movies rated above 8.4",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"rating": {"$gt": 8.4}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "rating": {"operator": "gt", "value": 8.4}
          },
          "expected_docs": ["Paprika", "Spirited Away", "Grave of the Fireflies"]
        },
        {
          "query": "forget the rating",
          "expected_filter": {"genre": {"$in": ["anime"]}},
          "expected_slots": {"genre": {"operator": "in", "value": ["anime"]}},
          "expect_cleared": ["rating"],
          "expected_docs": ["Paprika", "Perfect Blue", "Akira", "My Neighbor Totoro", "Spirited Away", "Grave of the Fireflies"]
        },
        {
          "query": "actually only Miyazaki ones",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"director": {"$eq": "Hayao Miyazaki"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "director": {"operator": "eq", "value": "Hayao Miyazaki"}
          },
          "expected_docs": ["My Neighbor Totoro", "Spirited Away"],
          "expected_answer_contains": ["Miyazaki"]
        }
      ]
    },
    {
      "id": "followup-05",
      "category": "followup",
      "mode": "structured",
      "description": "Topic change must reset slots rather than carry them.",
      "turns": [
        {
          "query": "anime movies by Satoshi Kon",
          "expected_filter": {"$and": [{"genre": {"$in": ["anime"]}}, {"director": {"$eq": "Satoshi Kon"}}]},
          "expected_slots": {
            "genre": {"operator": "in", "value": ["anime"]},
            "director": {"operator": "eq", "value": "Satoshi Kon"}
          },
          "expected_docs": ["Paprika", "Perfect Blue"]
        },
        {
          "query": "show me comedy films instead",
          "expected_filter": {"genre": {"$in": ["comedy"]}},
          "expected_slots": {"genre": {"operator": "in", "value": ["comedy"]}},
          "expect_absent_slots": ["director"],
          "expected_docs": ["Lady Bird", "Toy Story", "Groundhog Day", "The Grand Budapest Hotel"],
          "expected_answer_contains": ["comedy"]
        }
      ]
    },

