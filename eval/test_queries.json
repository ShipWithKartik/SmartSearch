    {
      "id": "temporal-04",
      "category": "temporal",
      "mode": "structured",
      "turns": [
        {
          "query": "movies from the 1990s",
          "expected_filter": {"$and": [{"release_date": {"$gte": "1990-01-01"}}, {"release_date": {"$lt": "2000-01-01"}}]},
          "expected_slots": {"release_date": {"operator": "gte", "value": "1990-01-01"}},
          "expected_docs": ["Perfect Blue", "Toy Story", "Jurassic Park", "Groundhog Day"],
          "expected_answer_contains": ["199"]
