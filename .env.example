# ─────────────────────────────────────────────────────────────────────────────
# SmartFilteringRAG — environment variables
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (vector search requires an Atlas cluster,
# not a local mongod). Free M0 tier works.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Groq API key — free at https://console.groq.com
# Named OPEN_AI_API_KEY because Groq is used through its OpenAI-compatible API.
OPEN_AI_API_KEY=gsk_your_groq_api_key_here

# Groq's OpenAI-compatible base URL.
OPEN_API_BASE=https://api.groq.com/openai/v1


# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Extra HTTP headers for the LLM endpoint, as a JSON object.
# Leave empty unless your provider/proxy requires them.
OPEN_API_DEFAULT_HEADERS=

# Model used ONLY by the faithfulness auditor (the second LLM call that checks
# whether the generated answer is grounded in the retrieved documents).
# Leave empty to reuse `model:` from config/config.yaml — the same Groq model
# as everything else, which is the default and needs no extra setup.
#
# Set this if you want the auditor to be a different (e.g. stronger) model than
# the one that wrote the answer: having a model grade its own output at the same
# settings is the weakest part of the check. Either stay on Groq, e.g.:
#   FAITHFULNESS_MODEL=llama-3.3-70b-versatile
# ...or point it at a different provider, e.g. Gemini (see below), e.g.:
#   FAITHFULNESS_MODEL=gemini-3.1-flash-lite
FAITHFULNESS_MODEL=

# API key + base URL for the faithfulness auditor, ONLY needed if it lives on a
# different provider than the main Groq pipeline above. Leave both empty to
# reuse OPEN_AI_API_KEY / OPEN_API_BASE (same provider as everything else).
#
# Example — Gemini via Google's OpenAI-compatible endpoint:
#   FAITHFULNESS_API_KEY=your_gemini_api_key_here
#   FAITHFULNESS_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
FAITHFULNESS_API_KEY=
FAITHFULNESS_API_BASE=

# ── Conversation persistence (optional) ─────────────────────────────────────
# MongoDB collection that stores every conversation turn (query, slots, filter,
# retrieved doc ids, answer, faithfulness, timings) so a browser session can be
# restored after a reload. Leave empty to use the config.yaml default
# ("conversation_logs"). Persistence is best-effort: if the cluster is
# unreachable the app still runs, just without saved history.
CONVERSATION_COLLECTION_NAME=
